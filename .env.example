APP_NAME=Monetka
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://monetka.local

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@monetka.local"
MAIL_FROM_NAME="${APP_NAME}"

# AI-помощник. Параметры можно безопасно менять в админке.
# Полный адрес запроса. Суффикс /chat/completions сам не добавляется.
# Ollama: AI_PROVIDER=ollama, AI_BASE_URL=http://127.0.0.1:11434/v1/chat/completions, AI_MODEL=llama3.2, ключ можно оставить пустым.
AI_PROVIDER=openrouter
AI_API_KEY=
AI_MODEL=qwen/qwen3.8-27b:free
AI_BASE_URL=https://openrouter.ai/api/v1/chat/completions
# AI_SYSTEM_PROMPT=  # необязательно; шаблон с {snapshot}, задаётся в /admin/ai

# Необязательно: адрес и ключ неофициального API «Проверка чеков»
# FNS_CLIENT_SECRET=
# FNS_BASE_URL=https://irkkt-mobile.nalog.ru:8888

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
